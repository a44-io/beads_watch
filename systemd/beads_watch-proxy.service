[Unit]
Description=beads_watch TCP bridge — proxy to the unix socket
Documentation=https://github.com/a44-io/beads_watch
Requires=beads_watch.service
After=beads_watch.service

[Service]
# The daemon keeps its 0600 unix socket (local consumers: omabeads plugin);
# this bridge plays the role tailscale serve used to — TCP in, socket out.
# Caddy on pi fronts it as https://beads-arch.dev.a44.io.
ExecStart=/usr/lib/systemd/systemd-socket-proxyd %t/beads_watch.sock
PrivateTmp=true
NoNewPrivileges=true
